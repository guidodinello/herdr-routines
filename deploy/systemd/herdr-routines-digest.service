[Unit]
Description=herdr-routines daily digest (issue 010)
After=herdr-server.service
Wants=herdr-server.service

[Service]
Type=oneshot
WorkingDirectory=%h/projects/herdr-routines
# Same PATH note as herdr-routines.service: a systemd --user unit does not inherit your
# login shell's PATH, and herdr.py invokes the bare command name "herdr" via subprocess.
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=%h/.local/bin/uv run herdr-routines digest --notify --timezone America/Montevideo

# A digest run is a handful of history/reports-dir reads plus one notification — bounded
# well under a minute in practice. Finite on purpose, same reasoning as the watchdog unit.
TimeoutStartSec=120
