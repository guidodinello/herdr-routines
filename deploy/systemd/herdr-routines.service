[Unit]
Description=herdr-routines tick
After=herdr-server.service
Wants=herdr-server.service

[Service]
Type=oneshot
WorkingDirectory=%h/projects/herdr-routines
# A systemd --user unit does not inherit your login shell's PATH — only a minimal default
# (usually /usr/local/bin:/usr/bin:/bin). herdr.py invokes the bare command name "herdr" (not
# a full path) via subprocess, so without this, every `herdr` call raises FileNotFoundError as
# soon as `uv run` hands off to herdr-routines, even though `ExecStart`'s own `uv` (given as a
# full path below) starts fine. %h/.local/bin covers the common `uv tool install`/pipx location
# for `herdr`; adjust if yours lives elsewhere (check with `command -v herdr` in your login shell).
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=%h/.local/bin/uv run herdr-routines tick

# NOT infinity. A tick blocks for the length of whatever job it runs (agent prompt --wait), so
# the naive choice is TimeoutStartSec=infinity — but that's a trap: if the herdr server dies or
# the socket goes away mid-run, an infinity unit never gets reclaimed, and because systemd won't
# start a second instance of a oneshot service while one is running, one wedged tick would
# silently disable every job forever. Set this to (sum of every enabled job's start+run timeout
# — jobs can share a tick, so worst case is all of them — plus 5 min margin); `herdr-routines
# validate` checks this file against jobs.yaml and tells you to bump it if it's too low.
# See docs/plan-v1.md §3.
TimeoutStartSec=25000
